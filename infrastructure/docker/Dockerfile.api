FROM node:20-alpine

WORKDIR /app

# Instalar pnpm
RUN npm install -g pnpm

# Copiar arquivos de workspace
COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY package.json ./
COPY tsconfig.json ./

# Copiar apps e packages
COPY apps/api ./apps/api
COPY packages ./packages

# Instalar dependências
RUN pnpm install --frozen-lockfile

# Build (se necessário)
RUN pnpm --filter @lavajato/api build || true

EXPOSE 3001

CMD ["pnpm", "--filter", "@lavajato/api", "dev"]
