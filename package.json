{
  "name": "site-lavajato",
  "version": "0.1.0",
  "description": "Sistema de gestão para lava-jatos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker-compose up",
    "dev:stop": "docker-compose down",
    "build": "turbo build",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "migrate": "cd apps/api && pnpm prisma migrate dev",
    "migrate:prod": "cd apps/api && pnpm prisma migrate deploy"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "admin-panel"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  }
}
