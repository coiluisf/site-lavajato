# Database
DATABASE_URL="postgresql://lavajato:password@postgres:5432/lavajato"
DATABASE_HOST="postgres"
DATABASE_PORT="5432"
DATABASE_USER="lavajato"
DATABASE_PASSWORD="password"
DATABASE_NAME="lavajato"

# API
API_PORT="3001"
API_ENV="development"

# JWT (gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your_secret_key_here_minimum_32_chars"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="your_refresh_secret_here_minimum_32_chars"
JWT_REFRESH_EXPIRATION="7d"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Environment
NODE_ENV="development"
