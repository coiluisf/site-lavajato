// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USUARIOS E AUTENTICACAO
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  passwordHash String

  role      Role     @default(OWNER)
  status    UserStatus @default(ACTIVE)

  isFirstLogin Boolean @default(true)
  lastLoginAt DateTime?
  lastLoginIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions UserSession[]
  resetTokens PasswordResetToken[]
  auditLogs AuditLog[]

  @@map("users")
}

model UserSession {
  id                String   @id @default(cuid())
  userId            String
  refreshTokenHash  String   // Hash do token
  expiresAt         DateTime
  issuedAt          DateTime @default(now())
  revokedAt         DateTime?

  userAgent         String?
  ipAddress         String?
  status            SessionStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   // Hash do token
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================================
// EMPRESA E CONFIGURACOES
// ============================================================================

model Company {
  id              String   @id @default(cuid())
  name            String
  displayName     String?
  cnpjCpf         String   @unique

  phone           String?
  whatsapp        String?
  email           String?
  address         String?

  businessHours   Json?    // { "monday": "08:00-18:00", ... }
  status          CompanyStatus @default(ACTIVE)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  settings        CompanySettings?
  customers       Customer[]
  vehicles        Vehicle[]
  services        Service[]
  employees       Employee[]
  appointments    Appointment[]
  orders          ServiceOrder[]
  payments        Payment[]
  expenses        Expense[]
  products        Product[]
  auditLogs       AuditLog[]

  @@map("companies")
}

model CompanySettings {
  id              String   @id @default(cuid())
  companyId       String   @unique

  businessName    String
  legalName       String?
  cnpjCpf         String

  phone           String?
  whatsapp        String?
  email           String?
  address         String?
  city            String?
  state           String?
  postalCode      String?

  businessHours   Json?
  noteHeader      String?
  noteFooter      String?
  receiptFooter   String?

  timezone        String   @default("America/Sao_Paulo")
  language        String   @default("pt-BR")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

// ============================================================================
// CLIENTES E VEICULOS
// ============================================================================

model Customer {
  id        String   @id @default(cuid())
  companyId String

  name      String
  email     String?
  phone     String
  whatsapp  String?
  cpf       String?

  address   String?
  city      String?
  state     String?

  notes     String?
  status    CustomerStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  appointments Appointment[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@map("customers")
}

model Vehicle {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String

  plate       String   @unique // Normalizado (sem caracteres especiais)
  make        String   // Marca (Toyota, Volkswagen, etc)
  model       String   // Modelo
  color       String?
  year        Int?

  categoryId  String
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category VehicleCategory @relation(fields: [categoryId], references: [id])
  appointments Appointment[]
  orders ServiceOrder[]

  @@unique([companyId, plate])
  @@index([companyId])
  @@index([customerId])
  @@map("vehicles")
}

model VehicleCategory {
  id        String   @id @default(cuid())
  companyId String

  name      String
  description String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("vehicle_categories")
}

// ============================================================================
// SERVICOS E PRECOS
// ============================================================================

model Service {
  id          String   @id @default(cuid())
  companyId   String

  name        String
  description String?
  durationMinutes Int
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prices ServicePrice[]
  orderItems ServiceOrderItem[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("services")
}

model ServicePrice {
  id                String   @id @default(cuid())
  companyId         String
  serviceId         String
  vehicleCategoryId String

  price             Decimal  @db.Decimal(10, 2)
  isActive          Boolean  @default(true)
  effectiveFrom     DateTime @default(now())
  effectiveUntil    DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category VehicleCategory @relation(fields: [vehicleCategoryId], references: [id])

  @@unique([companyId, serviceId, vehicleCategoryId])
  @@index([companyId])
  @@map("service_prices")
}

// ============================================================================
// FUNCIONARIOS
// ============================================================================

model Employee {
  id          String   @id @default(cuid())
  companyId   String

  name        String
  cpf         String   // Normalizado
  phone       String?
  email       String?

  role        EmployeeRole
  commissionPercentage Decimal? @db.Decimal(5, 2)
  salary      Decimal? @db.Decimal(10, 2)

  status      EmployeeStatus @default(ACTIVE)
  userId      String?  // Referência ao usuário do sistema (se tiver)
  hiredAt     DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, cpf])
  @@index([companyId])
  @@map("employees")
}

// ============================================================================
// AGENDAMENTOS E ORDENS
// ============================================================================

model Appointment {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  vehicleId   String
  serviceId   String

  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  orders ServiceOrder[]

  @@index([companyId])
  @@index([customerId])
  @@map("appointments")
}

model ServiceOrder {
  id          String   @id @default(cuid())
  companyId   String
  appointmentId String?
  customerId  String
  vehicleId   String

  orderNumber Int      // Número sequencial por empresa
  status      OrderStatus @default(DRAFT)

  totalPrice  Decimal? @db.Decimal(10, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items ServiceOrderItem[]
  payments Payment[]

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([customerId])
  @@map("service_orders")
}

model ServiceOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  serviceId   String

  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(10, 2)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("service_order_items")
}

// ============================================================================
// PAGAMENTOS E CAIXA
// ============================================================================

model Payment {
  id          String   @id @default(cuid())
  companyId   String
  orderId     String

  amount      Decimal  @db.Decimal(10, 2)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)

  paidAt      DateTime?
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([orderId])
  @@map("payments")
}

model Expense {
  id          String   @id @default(cuid())
  companyId   String

  description String
  amount      Decimal  @db.Decimal(10, 2)
  category    String?

  date        DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("expenses")
}

// ============================================================================
// ESTOQUE
// ============================================================================

model Product {
  id          String   @id @default(cuid())
  companyId   String

  name        String
  description String?
  quantity    Int      @default(0)

  costPrice   Decimal? @db.Decimal(10, 2)
  sellPrice   Decimal? @db.Decimal(10, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@index([companyId])
  @@map("products")
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String

  type        MovementType // ENTRADA, SAIDA, AJUSTE
  quantity    Int
  notes       String?

  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("stock_movements")
}

// ============================================================================
// AUDITORIA
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  userId      String

  action      String   // CREATE, UPDATE, DELETE, etc
  entityType  String   // "Customer", "Vehicle", "Order", etc
  entityId    String   // ID da entidade modificada

  changes     Json?    // { "field": { "from": "old", "to": "new" } }

  ipAddress   String?
  userAgent   String?

  timestamp   DateTime @default(now())
  status      AuditStatus @default(SUCCESS)
  errorMessage String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  OWNER
  MANAGER
  ATTENDANT
  WASHER
  FINANCE
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeRole {
  OWNER
  MANAGER
  ATTENDANT
  WASHER
  FINANCE
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  WAITING
  IN_PREPARATION
  IN_SERVICE
  QUALITY_CHECK
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  PIX
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum MovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

enum AuditStatus {
  SUCCESS
  FAILURE
}
