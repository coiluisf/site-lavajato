// Prisma schema para MySQL (Hostinger)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USUARIOS E AUTENTICACAO
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  passwordHash String   @db.Text

  role      Role     @default(OWNER)
  status    UserStatus @default(ACTIVE)

  isFirstLogin Boolean @default(true)
  lastLoginAt DateTime?
  lastLoginIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions UserSession[]
  resetTokens PasswordResetToken[]
  auditLogs AuditLog[]

  @@map("users")
}

model UserSession {
  id                String   @id @default(cuid())
  userId            String
  refreshTokenHash  String   @db.Text
  expiresAt         DateTime
  issuedAt          DateTime @default(now())
  revokedAt         DateTime?

  userAgent         String?  @db.Text
  ipAddress         String?
  status            SessionStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @db.Text
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================================
// EMPRESA E CONFIGURACOES
// ============================================================================

model Company {
  id              String   @id @default(cuid())
  name            String
  displayName     String?
  cnpjCpf         String   @unique(map: "unique_cnpj_cpf")

  phone           String?
  whatsapp        String?
  email           String?
  address         String?  @db.Text

  businessHours   Json?
  status          CompanyStatus @default(ACTIVE)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  settings        CompanySettings?
  customers       Customer[]
  vehicles        Vehicle[]
  services        Service[]
  employees       Employee[]
  appointments    Appointment[]
  orders          ServiceOrder[]
  payments        Payment[]
  expenses        Expense[]
  products        Product[]
  auditLogs       AuditLog[]

  @@map("companies")
}

model CompanySettings {
  id              String   @id @default(cuid())
  companyId       String   @unique

  businessName    String
  legalName       String?
  cnpjCpf         String

  phone           String?
  whatsapp        String?
  email           String?
  address         String?  @db.Text
  city            String?
  state           String?
  postalCode      String?

  businessHours   Json?
  noteHeader      String?  @db.Text
  noteFooter      String?  @db.Text
  receiptFooter   String?  @db.Text

  timezone        String   @default("America/Sao_Paulo")
  language        String   @default("pt-BR")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

// ============================================================================
// CLIENTES E VEICULOS
// ============================================================================

model Customer {
  id        String   @id @default(cuid())
  companyId String

  name      String
  email     String?
  phone     String
  whatsapp  String?
  cpf       String?

  address   String?  @db.Text
  city      String?
  state     String?

  notes     String?  @db.Text
  status    CustomerStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  appointments Appointment[]

  @@unique([companyId, phone], map: "unique_company_phone")
  @@index([companyId])
  @@map("customers")
}

model Vehicle {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String

  plate       String   @unique
  make        String
  model       String
  color       String?
  year        Int?

  categoryId  String
  notes       String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category VehicleCategory @relation(fields: [categoryId], references: [id])
  appointments Appointment[]
  orders ServiceOrder[]

  @@unique([companyId, plate], map: "unique_company_plate")
  @@index([companyId])
  @@index([customerId])
  @@map("vehicles")
}

model VehicleCategory {
  id        String   @id @default(cuid())
  companyId String

  name      String
  description String?  @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@unique([companyId, name], map: "unique_company_category")
  @@index([companyId])
  @@map("vehicle_categories")
}

// ============================================================================
// SERVICOS E PRECOS
// ============================================================================

model Service {
  id          String   @id @default(cuid())
  companyId   String

  name        String
  description String?  @db.Text
  durationMinutes Int
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prices ServicePrice[]
  orderItems ServiceOrderItem[]

  @@unique([companyId, name], map: "unique_company_service")
  @@index([companyId])
  @@map("services")
}

model ServicePrice {
  id                String   @id @default(cuid())
  companyId         String
  serviceId         String
  vehicleCategoryId String

  price             Decimal  @db.Decimal(10, 2)
  isActive          Boolean  @default(true)
  effectiveFrom     DateTime @default(now())
  effectiveUntil    DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category VehicleCategory @relation(fields: [vehicleCategoryId], references: [id])

  @@unique([companyId, serviceId, vehicleCategoryId], map: "unique_company_service_category")
  @@index([companyId])
  @@map("service_prices")
}

// ============================================================================
// FUNCIONARIOS
// ============================================================================

model Employee {
  id          String   @id @default(cuid())
  companyId   String

  name        String
  cpf         String
  phone       String?
  email       String?

  role        EmployeeRole
  commissionPercentage Decimal? @db.Decimal(5, 2)
  salary      Decimal? @db.Decimal(10, 2)

  status      EmployeeStatus @default(ACTIVE)
  userId      String?
  hiredAt     DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, cpf], map: "unique_company_cpf")
  @@index([companyId])
  @@map("employees")
}

// ============================================================================
// AGENDAMENTOS E ORDENS
// ============================================================================

model Appointment {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  vehicleId   String
  serviceId   String

  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  orders ServiceOrder[]

  @@index([companyId])
  @@index([customerId])
  @@map("appointments")
}

model ServiceOrder {
  id          String   @id @default(cuid())
  companyId   String
  appointmentId String?
  customerId  String
  vehicleId   String

  orderNumber Int
  status      OrderStatus @default(DRAFT)

  totalPrice  Decimal? @db.Decimal(10, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items ServiceOrderItem[]
  payments Payment[]

  @@unique([companyId, orderNumber], map: "unique_company_order_number")
  @@index([companyId])
  @@index([customerId])
  @@map("service_orders")
}

model ServiceOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  serviceId   String

  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(10, 2)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("service_order_items")
}

// ============================================================================
// PAGAMENTOS E CAIXA
// ============================================================================

model Payment {
  id          String   @id @default(cuid())
  companyId   String
  orderId     String

  amount      Decimal  @db.Decimal(10, 2)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)

  paidAt      DateTime?
  notes       String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([orderId])
  @@map("payments")
}

model Expense {
  id          String   @id @default(cuid())
  companyId   String

  description String
  amount      Decimal  @db.Decimal(10, 2)
  category    String?

  date        DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("expenses")
}

// ============================================================================
// ESTOQUE
// ============================================================================

model Product {
  id          String   @id @default(cuid())
  companyId   String

  name        String
  description String?  @db.Text
  quantity    Int      @default(0)

  costPrice   Decimal? @db.Decimal(10, 2)
  sellPrice   Decimal? @db.Decimal(10, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@index([companyId])
  @@map("products")
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String

  type        MovementType
  quantity    Int
  notes       String?  @db.Text

  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("stock_movements")
}

// ============================================================================
// AUDITORIA
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  userId      String

  action      String
  entityType  String
  entityId    String

  changes     Json?
  ipAddress   String?
  userAgent   String?  @db.Text

  timestamp   DateTime @default(now())
  status      AuditStatus @default(SUCCESS)
  errorMessage String?  @db.Text

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  OWNER
  MANAGER
  ATTENDANT
  WASHER
  FINANCE
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeRole {
  OWNER
  MANAGER
  ATTENDANT
  WASHER
  FINANCE
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  WAITING
  IN_PREPARATION
  IN_SERVICE
  QUALITY_CHECK
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  PIX
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum MovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

enum AuditStatus {
  SUCCESS
  FAILURE
}
