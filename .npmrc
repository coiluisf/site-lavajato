shamefully-hoist=true
strict-peer-dependencies=false
minimum-release-age=0
confirm-modules-purge=false
ci=true

# Ignore build scripts for packages that have pre-built binaries or are optional
# This prevents ERR_PNPM_IGNORED_BUILDS errors - we don't need these builds
# Prisma Client is generated during 'pnpm run build', not during install
ignore-built-dependencies[]=@nestjs/core
ignore-built-dependencies[]=@prisma/client
ignore-built-dependencies[]=@prisma/engines
ignore-built-dependencies[]=prisma
